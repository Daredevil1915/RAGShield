# Copy to .env locally. Configure secrets in Render's Environment page.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0
# Optional bearer token for a protected hosted Ollama server.
OLLAMA_API_KEY=
APP_DB_DIR=data/app_chroma
APP_MIN_RELEVANCE=0.55
APP_MAX_UPLOAD_MB=25
APP_MAX_PAGES=500
APP_RESEARCH_DEMO=1
# Optional locally; Render generates one automatically.
DEMO_PASSWORD=
