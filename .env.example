# Copy to .env locally. Configure secrets in Render's Environment page.
# Cloud default: no Ollama installation and no running laptop required.
MODEL_PROVIDER=ollama_cloud
EMBEDDING_PROVIDER=openai
OLLAMA_CLOUD_MODEL=gemma4:31b
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# Optional separate embedding service; defaults to OPENAI_BASE_URL / OPENAI_API_KEY.
# OPENAI_EMBED_BASE_URL=https://your-embedding-provider.example/v1
# OPENAI_EMBED_API_KEY=
# Optional local research only: MODEL_PROVIDER=ollama and EMBEDDING_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0
# Ollama Cloud API key (chat).
OLLAMA_API_KEY=
APP_DB_DIR=data/app_chroma
APP_MIN_RELEVANCE=0.55
APP_MAX_UPLOAD_MB=25
APP_MAX_PAGES=500
APP_RESEARCH_DEMO=1
